profiles {
  local {
    process.executor = "local"
  }

  docker {
    docker.enabled = true
    process.container = "python:3.11-slim"
  }

  awsbatch {
    process.executor = "awsbatch"
    process.queue = "perturbseq-benchmark"
    aws.region = "us-west-2"
    workDir = "s3://YOUR_BUCKET/perturbseq-benchmark/work"
  }

  real_awsbatch {
    process.executor = "awsbatch"
    process.queue = System.getenv('AWS_BATCH_QUEUE')
    aws.region = System.getenv('AWS_REGION') ?: 'us-west-2'
    workDir = System.getenv('PERTURBSEQ_WORKDIR')
  }
}

process {
  cpus = 1
  memory = "2 GB"
  time = "1h"
}
